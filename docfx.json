        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "template"
    ],
    "globalMetadata": {
      "_appName": "Framework",
      "_appTitle": "Nuv Tools Framework",
      "_appLogoPath": "images/nuvtools-brand.svg",
      "_appFaviconPath": "images/icon.png",
      "_enableSearch": true,
      "_disableContribution": true,
      "_lang": "en",
      "_appFooter": "<span>\u00a9 Nuv Tools \u00b7 <a href=\"https://nuvtools.com/framework/\">nuvtools.com</a> \u00b7 MIT licence \u00b7 Built with <a href=\"https://dotnet.github.io/docfx\">docfx</a></span>"
    },
    "sitemap": {
      "baseUrl": "https://docs.nuvtools.com/",
